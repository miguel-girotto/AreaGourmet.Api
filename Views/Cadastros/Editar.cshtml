@model CadastroForm
@{ string tipo = ViewBag.Tipo; ViewData["Title"] = Model.Id == 0 ? "Novo cadastro" : "Editar cadastro"; }
<header class="page-header"><div><span class="eyebrow">@tipo</span><h1>@ViewData["Title"]</h1><p>Preencha os dados e salve as alterações.</p></div><a class="btn secondary" href="/Cadastros?tipo=@tipo">Voltar à lista</a></header>
<form asp-action="Editar" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input name="tipo" value="@tipo" type="hidden" /><input asp-for="Id" type="hidden" /><label asp-for="Nome">Nome</label><input asp-for="Nome" required minlength="2" maxlength="100" />
@if (tipo == "Clientes") { <label asp-for="Telefone">Telefone com DDD</label><input asp-for="Telefone" type="tel" required maxlength="20" placeholder="(18) 99999-0000" /> }
@if (tipo == "Produtos") { <div class="form-grid"><label>Categoria<select asp-for="CategoriaId" required><option value="">Selecione</option>@foreach (Categoria c in ViewBag.Categorias) { <option value="@c.Id">@c.Nome</option> }</select></label><label>Preço (R$)<input asp-for="PrecoAtual" type="number" value="@Model.PrecoAtual?.ToString(CultureInfo.InvariantCulture)" min="0.01" max="999999.99" step="0.01" required /></label></div><label class="checkbox"><input asp-for="DisponivelVenda" />Exibir no cardápio de vendas</label><p class="muted">Para embalagens e outros insumos, desmarque esta opção. Preços de pedidos anteriores são preservados.</p> }
<label class="checkbox"><input asp-for="Ativo" />Cadastro ativo</label><div class="form-actions"><button class="btn primary">Salvar cadastro</button><a class="btn secondary" href="/Cadastros?tipo=@tipo">Cancelar</a></div></form>

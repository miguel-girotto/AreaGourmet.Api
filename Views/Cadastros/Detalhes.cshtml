@model CadastroForm
@{ string tipo = ViewBag.Tipo; ViewData["Title"] = Model.Nome; bool escrita = User.IsInRole("Administrador") || User.HasClaim("clientes", "sim"); }
<header class="page-header"><div><span class="eyebrow">@tipo / #@Model.Id</span><h1>@Model.Nome</h1><p>@(Model.Ativo ? "Cadastro ativo" : "Cadastro inativo")</p></div><div class="row-actions"><a href="/Cadastros?tipo=@tipo" class="btn secondary">Voltar</a>@if (escrita) { <a href="/Cadastros/Editar?tipo=@tipo&id=@Model.Id" class="btn primary">Editar cadastro</a> }</div></header>
<section class="panel"><dl class="detail-grid"><div><dt>Nome</dt><dd>@Model.Nome</dd></div>@if (tipo == "Clientes") { <div><dt>Telefone</dt><dd>@Model.Telefone</dd></div> }@if (tipo == "Produtos") { <div><dt>Preço atual</dt><dd>@Model.PrecoAtual?.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</dd></div><div><dt>Categoria</dt><dd>@(((List<Categoria>)ViewBag.Categorias).FirstOrDefault(c => c.Id == Model.CategoriaId)?.Nome ?? "Categoria inativa")</dd></div><div><dt>No cardápio</dt><dd>@(Model.DisponivelVenda ? "Sim" : "Não")</dd></div> }</dl></section>
@if (tipo == "Clientes") { <section class="panel"><div class="table-heading"><h2>Endereços de entrega</h2>@if (escrita && Model.Ativo) { <a href="/Cadastros/Endereco?clienteId=@Model.Id" class="btn outline small">＋ Adicionar endereço</a> }</div><div class="address-grid">@foreach (Endereco e in ViewBag.Enderecos) { <article class="address-card"><span class="badge">@(e.Rotulo ?? "Endereço")</span><h3>@e.Logradouro, @e.Numero</h3><p>@e.Bairro<br />@e.Complemento</p>@if (escrita && Model.Ativo) { <a href="/Cadastros/Endereco?clienteId=@Model.Id&id=@e.Id">Editar endereço →</a> }</article> }</div>@if (((List<Endereco>)ViewBag.Enderecos).Count == 0) { <p class="muted">Nenhum endereço cadastrado.</p> }</section> }

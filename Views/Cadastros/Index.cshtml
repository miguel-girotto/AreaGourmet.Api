@model List<CadastroLinha>
@{ string tipo = ViewBag.Tipo; ViewData["Title"] = tipo; bool escrita = User.IsInRole("Administrador") || User.HasClaim("clientes", "sim"); }
<header class="page-header"><div><span class="eyebrow">CADASTROS</span><h1>@tipo</h1><p>Informações organizadas para um atendimento melhor.</p></div>@if (escrita) { <a class="btn primary" href="/Cadastros/Editar?tipo=@tipo">＋ Novo cadastro</a> }</header>
<form method="get" class="filters panel"><input type="hidden" name="tipo" value="@tipo" /><label>Pesquisar<input name="q" value="@ViewBag.Q" placeholder="@(tipo == "Clientes" ? "Nome ou telefone" : "Nome")" /></label><label>Situação<select name="situacao"><option value="ativos" selected="@(ViewBag.Situacao == "ativos")">Ativos</option><option value="inativos" selected="@(ViewBag.Situacao == "inativos")">Inativos</option><option value="todos" selected="@(ViewBag.Situacao == "todos")">Todos</option></select></label>@if (tipo == "Produtos") { <label>Categoria<select name="categoriaId"><option value="">Todas</option>@foreach (Categoria c in ViewBag.Categorias) { <option value="@c.Id" selected="@(ViewBag.CategoriaId == c.Id)">@c.Nome</option> }</select></label> }<button class="btn primary">Filtrar</button><a class="btn secondary" href="/Cadastros?tipo=@tipo">Limpar</a></form>
<section class="panel table-panel"><div class="table-heading"><h2>Lista de @tipo.ToLower()</h2><span class="muted">@Model.Count registros</span></div><div class="table-wrap"><table><thead><tr><th>Nome</th><th>@(tipo == "Clientes" ? "Telefone" : "Categoria / descrição")</th>@if (tipo == "Produtos") { <th>Preço</th> }<th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td><strong>@c.Nome</strong><small>#@c.Id</small></td><td>@c.Detalhe</td>@if (tipo == "Produtos") { <td>@c.Valor?.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td> }<td><span class="badge @(c.Ativo ? "" : "neutral")">@(c.Ativo ? "Ativo" : "Inativo")</span></td><td><div class="row-actions"><a class="btn secondary small" href="/Cadastros/Detalhes?tipo=@tipo&id=@c.Id">Detalhes</a>@if (escrita) { <a class="btn outline small" href="/Cadastros/Editar?tipo=@tipo&id=@c.Id">Editar</a>@if (c.Ativo) { <form asp-action="Desativar" method="post" data-confirm="Desativar este cadastro? O histórico será preservado."><input type="hidden" name="tipo" value="@tipo" /><input type="hidden" name="id" value="@c.Id" /><button class="btn danger small">Desativar</button></form> } }</div></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <div class="empty-state">Nenhum cadastro encontrado para os filtros.</div> }</section>

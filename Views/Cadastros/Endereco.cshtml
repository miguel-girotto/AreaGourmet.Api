@model EnderecoForm
@{ ViewData["Title"] = Model.Id == 0 ? "Novo endereço" : "Editar endereço"; }
<header class="page-header"><div><span class="eyebrow">CLIENTES</span><h1>@ViewData["Title"]</h1><p>Um cliente pode ter vários endereços.</p></div></header>
<form asp-action="Endereco" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="ClienteId" type="hidden" /><label asp-for="Rotulo">Identificação (casa, trabalho…)</label><input asp-for="Rotulo" maxlength="40" /><label asp-for="Logradouro">Rua ou avenida</label><input asp-for="Logradouro" required maxlength="150" /><div class="form-grid"><label>Número<input asp-for="Numero" required maxlength="20" /></label><label>Bairro<input asp-for="Bairro" required maxlength="80" /></label></div><label asp-for="Complemento">Complemento</label><input asp-for="Complemento" maxlength="100" /><div class="form-actions"><button class="btn primary">Salvar endereço</button><a class="btn secondary" href="/Cadastros/Detalhes?tipo=Clientes&id=@Model.ClienteId">Cancelar</a></div></form>

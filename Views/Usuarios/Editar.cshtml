@model UsuarioForm
@{ ViewData["Title"] = Model.Id == 0 ? "Novo usuário" : "Editar usuário"; }
<header class="page-header"><div><span class="eyebrow">ACESSO E PERMISSÕES</span><h1>@ViewData["Title"]</h1><p>Alterações de acesso encerram as sessões anteriores da conta.</p></div></header><form asp-action="Editar" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="Id" type="hidden" /><label asp-for="Nome">Nome</label><input asp-for="Nome" required minlength="2" maxlength="100" /><label asp-for="Login">Login</label><input asp-for="Login" required minlength="3" maxlength="80" autocomplete="off" /><label asp-for="Perfil">Perfil</label><select asp-for="Perfil"><option>Caixa</option><option>Administrador</option></select><label asp-for="Senha">@(Model.Id == 0 ? "Senha inicial" : "Nova senha (deixe em branco para manter)")</label><input name="Senha" id="Senha" type="password" value="" minlength="12" maxlength="128" autocomplete="new-password" required="@(Model.Id == 0)" /><small class="muted">De 12 a 128 caracteres. Compartilhe a senha inicial por um canal seguro.</small><label class="checkbox"><input asp-for="PodeCadastrarClientes" />Permitir cadastro e edição de clientes</label><label class="checkbox"><input asp-for="Ativo" />Conta ativa</label><div class="form-actions"><button class="btn primary">Salvar usuário</button><a class="btn secondary" href="/Usuarios">Cancelar</a></div></form>

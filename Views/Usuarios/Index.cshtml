@model List<UsuarioForm>
@{ ViewData["Title"] = "Usuários"; }
<header class="page-header"><div><span class="eyebrow">CONTROLE DE ACESSO</span><h1>Usuários</h1><p>Gerencie operadores, permissões e contas.</p></div><a href="/Usuarios/Editar" class="btn primary">＋ Novo usuário</a></header><form method="get" class="filters panel"><label>Pesquisar<input name="q" value="@ViewBag.Q" placeholder="Nome ou login" /></label><button class="btn primary">Filtrar</button></form><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Login</th><th>Perfil</th><th>Situação</th><th>Ação</th></tr></thead><tbody>@foreach (var u in Model) { <tr><td>@u.Nome</td><td>@u.Login</td><td>@u.Perfil</td><td><span class="badge">@(u.Ativo ? "Ativo" : "Inativo")</span></td><td><a class="btn outline small" href="/Usuarios/Editar/@u.Id">Editar acesso</a></td></tr> }</tbody></table></div></section>

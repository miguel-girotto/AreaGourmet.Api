@{ViewData["Title"]="O restaurante";var info=Restaurante.Value;}
<section class="page restaurant-page"><p class="eyebrow">DA NOSSA COZINHA PARA O SEU DIA</p><h1>@info.Nome</h1><p class="muted">Restaurante em @info.Cidade</p>
<div class="restaurant-profile"><div class="restaurant-photo"><img src="@ProductImages.Url("meal.jpg")" alt="Foto ilustrativa de uma refeição brasileira"/></div><div class="restaurant-story"><img src="/images/area-gourmet-logo.png" alt="Logo Área Gourmet" class="profile-logo"/><h2>Comida de verdade.<br/>De domingo a domingo.</h2><p>Os sabores do dia, o cuidado de sempre.</p><div class="restaurant-detail"><small>ATENDIMENTO</small><strong>@info.Atendimento</strong></div><div class="restaurant-detail"><small>CONTATO</small><a href="@info.WhatsApp" target="_blank" rel="noopener noreferrer">@info.Telefone →</a></div><div class="restaurant-detail"><small>ONDE ESTAMOS</small><a href="@info.Mapa" target="_blank" rel="noopener noreferrer">@info.Endereco →</a></div><div class="actions"><a class="button primary" href="@info.Instagram" target="_blank" rel="noopener noreferrer">Instagram →</a><a class="button" href="/Vendas">Montar pedido</a></div></div></div>
<p class="photo-disclaimer">Fotografias ilustrativas. @if(info.CardapioDemonstrativo){<span>Os produtos e preços deste sistema são demonstrativos e não representam o cardápio oficial do restaurante.</span>} <a href="/images/CREDITOS.txt" target="_blank" rel="noopener noreferrer">Créditos das fotografias</a>.</p></section>

@inject IWebHostEnvironment Ambiente
@{ ViewData["Title"] = "Painel administrativo"; }
<header class="page-header"><div><span class="eyebrow">VISÃO GERAL</span><h1>Painel administrativo</h1><p>Acompanhe o movimento do seu negócio.</p></div><a href="/Vendas" class="btn primary">Novo pedido</a></header>
<div class="stats"><article><small>Vendas finalizadas</small><strong>@(((decimal)ViewBag.Vendas).ToString("C", CultureInfo.GetCultureInfo("pt-BR")))</strong></article><article><small>Pedidos registrados</small><strong>@ViewBag.Pedidos</strong></article><article><small>Clientes ativos</small><strong>@ViewBag.Clientes</strong></article><article><small>Itens com estoque baixo</small><strong>@ViewBag.EstoqueBaixo</strong></article></div>
<div class="dashboard-grid"><a class="panel feature" href="/Relatorios"><svg><use href="/img/icons.svg#chart" /></svg><h2>Entenda suas vendas</h2><p>Totais por pagamento, produtos mais vendidos e pivot por modalidade.</p><span>Ver relatórios →</span></a><a class="panel feature" href="/Estoque"><svg><use href="/img/icons.svg#box" /></svg><h2>Estoque sob controle</h2><p>Consulte saldos, registre entradas e configure o consumo de embalagens.</p><span>Abrir estoque →</span></a></div>
@if (Ambiente.IsDevelopment()) { <section class="panel"><h2>Preparar demonstração</h2><p>Insere cardápio, um cliente fictício com dois endereços e estoque inicial. Não cria senhas, apaga dados ou repõe saldos já cadastrados.</p><form asp-controller="Demo" asp-action="Gerar" method="post" data-confirm="Inserir os dados de demonstração?"><button class="btn secondary">Gerar dados de demonstração</button></form></section> }

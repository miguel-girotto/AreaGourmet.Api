@model List<Cliente>
@{ViewData["Title"]="Clientes";}
<section class="page"><header class="page-header"><div><p class="eyebrow">RELACIONAMENTO</p><h1>Clientes</h1><p class="muted">Contatos e endereços para cada pedido.</p></div><a class="button primary" href="/Clientes/Editar">+ Novo cliente</a></header><form method="get" class="filters"><input name="busca" value="@ViewBag.Busca" placeholder="Nome ou telefone" aria-label="Buscar clientes"/><button>Filtrar</button><a href="/Clientes">Limpar</a></form><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Telefone</th><th>Status</th><th>Ações</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Nome</td><td>@c.Telefone</td><td><span class="badge">@(c.Ativo?"Ativo":"Inativo")</span></td><td><a href="/Clientes/Editar/@c.Id">Editar / endereços</a>@if(User.IsInRole("Administrador")&&c.Ativo){<form asp-action="Excluir" asp-route-id="@c.Id" method="post" class="inline confirm"><button class="danger">Inativar</button></form>}</td></tr>}</tbody></table></div><p class="muted">@Model.Count registro(s). Exibição limitada a 200; use o filtro.</p></section>

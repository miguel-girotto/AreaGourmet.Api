@model IEnumerable<AreaGourmet.Api.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Clientes</h2>
        <p class="text-muted mb-0">Gerenciamento de clientes cadastrados no sistema</p>
    </div>
    <a href="/clientes/criar" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Novo Cliente
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                <h5>Nenhum cliente cadastrado ainda.</h5>
                <p>Clique no botão acima para adicionar o primeiro cliente.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nome</th>
                            <th>Telefone</th>
                            <th>Data de Cadastro</th>
                            <th>Endereços</th>
                            <th class="text-end pe-4">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-secondary">#@item.Id</td>
                                <td class="fw-bold">@item.Nome</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-telephone me-1 text-muted"></i>@item.Telefone
                                    </span>
                                </td>
                                <td>@item.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @item.Enderecos.Count endereço(s)
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a href="/clientes/detalhes/@item.Id" class="btn btn-outline-info" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a href="/clientes/editar/@item.Id" class="btn btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="/clientes/excluir/@item.Id" class="btn btn-outline-danger" title="Excluir">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

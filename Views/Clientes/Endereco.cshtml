@model Endereco
@{ViewData["Title"]="Endereço do cliente";}
<section class="page"><h1>Endereço do cliente</h1><form method="post" asp-action="Endereco" class="form-card"><div asp-validation-summary="All" class="validation"></div><input asp-for="Id" type="hidden"/><input asp-for="ClienteId" type="hidden"/><label>Logradouro<input asp-for="Logradouro" required maxlength="150"/></label><div class="form-grid"><label>Número<input asp-for="Numero" required maxlength="15"/></label><label>Bairro<input asp-for="Bairro" required maxlength="80"/></label></div><div class="form-grid"><label>Cidade<input asp-for="Cidade" required maxlength="80"/></label><label>CEP<input asp-for="CEP" inputmode="numeric" pattern="[0-9]{8}" required/></label></div>@if(User.IsInRole("Administrador")){<label class="check"><input asp-for="Ativo"/>Endereço ativo</label>}<div class="actions"><button class="primary">Salvar endereço</button><a href="/Clientes/Editar/@Model.ClienteId">Voltar</a></div></form></section>

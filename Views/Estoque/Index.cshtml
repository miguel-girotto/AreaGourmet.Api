@model List<EstoqueBebida>
@{ ViewData["Title"] = "Estoque"; }
<header class="page-header"><div><span class="eyebrow">CONTROLE DE INSUMOS</span><h1>Estoque</h1><p>Bebidas, embalagens e insumos com saldo rastreável.</p></div><div class="row-actions"><a class="btn secondary" href="/Estoque/Consumos">Configurar consumo</a><a class="btn primary" href="/Estoque/Movimento">＋ Registrar movimento</a></div></header><form method="get" class="filters panel"><label>Produto<input name="q" value="@ViewBag.Q" /></label><label class="checkbox"><input type="checkbox" name="baixo" value="true" checked="@ViewBag.Baixo" />Somente estoque baixo</label><button class="btn primary">Filtrar</button><a class="btn secondary" href="/Estoque/Historico">Histórico</a></form><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Produto / insumo</th><th>Saldo atual</th><th>Mínimo</th><th>Situação</th><th></th></tr></thead><tbody>@foreach (var e in Model) { <tr><td>@e.Produto.Nome</td><td>@e.QuantidadeAtual.ToString("0.###")</td><td>@e.QuantidadeMinima.ToString("0.###")</td><td><span class="badge @(e.QuantidadeAtual <= e.QuantidadeMinima ? "warning" : "")">@(e.QuantidadeAtual <= e.QuantidadeMinima ? "Repor estoque" : "Regular")</span></td><td><a class="btn outline small" href="/Estoque/Movimento?produtoId=@e.ProdutoId">Movimentar</a></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="empty-state">Nenhum saldo encontrado. Cadastre uma entrada para controlar um produto.</p> }</section>

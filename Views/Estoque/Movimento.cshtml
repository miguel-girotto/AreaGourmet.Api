@model MovimentoForm
@{ ViewData["Title"] = "Registrar movimento"; }
<header class="page-header"><div><span class="eyebrow">ESTOQUE</span><h1>Registrar movimento</h1><p>Entradas e saídas ficam registradas com seu usuário.</p></div></header><form asp-action="Movimento" method="post" class="panel form-panel"><div asp-validation-summary="All" class="validation" role="alert"></div><label>Produto ou insumo<select asp-for="ProdutoId" required><option value="">Selecione</option>@foreach (Produto p in ViewBag.Produtos) { <option value="@p.Id">@p.Nome</option> }</select></label><label>Tipo<select asp-for="Tipo"><option value="ENTRADA">Entrada</option><option value="SAIDA">Saída manual</option></select></label><div class="form-grid"><label>Quantidade<input asp-for="Quantidade" type="number" min="0.001" max="999999.999" step="0.001" required /></label><label>Estoque mínimo<input asp-for="QuantidadeMinima" type="number" min="0" max="999999.999" step="0.001" required /></label></div><label>Observação<textarea asp-for="Observacao" required maxlength="300" rows="3"></textarea></label><div class="form-actions"><button class="btn primary">Registrar movimento</button><a class="btn secondary" href="/Estoque">Cancelar</a></div></form>

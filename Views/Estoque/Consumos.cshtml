@model ConsumoForm
@{ ViewData["Title"] = "Consumo de insumos"; }
<header class="page-header"><div><span class="eyebrow">REGRAS DE BAIXA</span><h1>Consumo de insumos</h1><p>Vincule, por exemplo, uma embalagem a cada marmita vendida.</p></div><a class="btn secondary" href="/Estoque">Voltar ao estoque</a></header><div class="alert info">Produtos com saldo próprio baixam uma unidade por unidade vendida. Associações abaixo adicionam consumo de outros insumos. Produtos sem saldo e sem associação não geram baixa.</div><form asp-action="Consumos" method="post" class="panel filters"><div asp-validation-summary="All" class="validation" role="alert"></div><label>Produto vendido<select asp-for="ProdutoId" required><option value="">Selecione</option>@foreach (Produto p in ViewBag.Produtos) { <option value="@p.Id">@p.Nome</option> }</select></label><label>Insumo consumido<select asp-for="EstoqueBebidaId" required><option value="">Selecione</option>@foreach (EstoqueBebida e in ViewBag.Estoques) { <option value="@e.Id">@e.Produto.Nome</option> }</select></label><label>Quantidade por unidade<input asp-for="Quantidade" type="number" min="0.001" step="0.001" max="9999.999" required /></label><button class="btn primary">Salvar associação</button></form><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Produto vendido</th><th>Insumo</th><th>Consumo por unidade</th><th></th></tr></thead><tbody>@foreach (ConsumoEstoque c in ViewBag.Consumos) { <tr><td>@c.Produto.Nome</td><td>@c.EstoqueBebida.Produto.Nome</td><td>@c.Quantidade.ToString("0.###")</td><td><form asp-action="RemoverConsumo" method="post" data-confirm="Remover esta regra para vendas futuras? Movimentações anteriores serão preservadas."><input name="id" type="hidden" value="@c.Id" /><button class="btn danger small">Remover associação</button></form></td></tr> }</tbody></table></div></section>

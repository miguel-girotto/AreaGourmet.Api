@model List<MovimentacaoEstoque>
@{ ViewData["Title"] = "Movimentações"; }
<header class="page-header"><div><span class="eyebrow">RASTREABILIDADE</span><h1>Movimentações de estoque</h1><p>Entradas, saídas, vendas e estornos sem apagar o histórico.</p></div><a class="btn primary" href="/Estoque/Movimento">Registrar movimento</a></header><form method="get" class="filters panel"><label>Produto<select name="produtoId"><option value="">Todos</option>@foreach (Produto p in ViewBag.Produtos) { <option value="@p.Id" selected="@(ViewBag.ProdutoId == p.Id)">@p.Nome</option> }</select></label><label>Tipo<select name="tipo"><option value="">Todos</option>@foreach (var t in new[] { "ENTRADA", "SAIDA", "VENDA", "ESTORNO" }) { <option selected="@(ViewBag.Tipo == t)">@t</option> }</select></label><label>De<input type="date" name="inicio" value="@(((DateTime?)ViewBag.Inicio)?.ToString("yyyy-MM-dd"))" /></label><label>Até<input type="date" name="fim" value="@(((DateTime?)ViewBag.Fim)?.ToString("yyyy-MM-dd"))" /></label><button class="btn primary">Filtrar</button><a class="btn secondary" href="/Estoque/Historico">Limpar</a></form><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Data (UTC)</th><th>Produto</th><th>Tipo</th><th>Quantidade</th><th>Saldo após</th><th>Operador</th><th>Pedido</th><th>Observação</th></tr></thead><tbody>@foreach (var m in Model) { <tr><td>@m.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@m.EstoqueBebida.Produto.Nome</td><td><span class="badge">@m.Tipo</span></td><td>@m.Quantidade.ToString("0.###")</td><td>@m.SaldoApos.ToString("0.###")</td><td>@m.Usuario.Nome</td><td>@if (m.PedidoId.HasValue) { <a href="/Pedidos/Detalhes/@m.PedidoId">#@m.PedidoId</a> }</td><td>@m.Observacao</td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="empty-state">Nenhuma movimentação encontrada.</p> }</section>

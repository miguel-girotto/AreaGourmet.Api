@model LoginForm
@{ ViewData["Title"] = "Entrar"; }
<div class="login-page"><section class="login-intro"><span class="eyebrow">AREA GOURMET / GESTÃO</span><h1>Mais cuidado<br />em cada pedido.</h1><p>Seu atendimento, cardápio e gestão<br />juntos no mesmo lugar.</p><div class="login-visual"><svg><use href="/img/icons.svg#chef" /></svg></div><small>Feito para o dia a dia da sua cozinha.</small></section><section class="login-panel"><div class="login-form"><span class="eyebrow">BEM-VINDO DE VOLTA</span><h2>Vamos começar?</h2><p class="muted">Entre com sua conta para acessar o sistema.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden" /><label asp-for="Login">Login</label><input asp-for="Login" autocomplete="username" required autofocus /><label asp-for="Senha">Senha</label><input asp-for="Senha" autocomplete="current-password" required /><button class="btn primary full" type="submit">Entrar no sistema <span aria-hidden="true">→</span></button></form><p class="login-help">Precisa de acesso? Fale com o administrador.</p></div></section></div>

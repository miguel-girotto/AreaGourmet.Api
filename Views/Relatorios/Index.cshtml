@model RelatorioVm
@{ ViewData["Title"] = "Relatórios"; var br = CultureInfo.GetCultureInfo("pt-BR"); }
<header class="page-header"><div><span class="eyebrow">INTELIGÊNCIA DO NEGÓCIO</span><h1>Relatórios de vendas</h1><p>Somente pedidos FINALIZADOS. Datas e filtros em UTC.</p></div></header><form method="get" class="filters panel"><label>De<input type="date" name="inicio" value="@(((DateTime)ViewBag.Inicio).ToString("yyyy-MM-dd"))" required /></label><label>Até<input type="date" name="fim" value="@(((DateTime)ViewBag.Fim).ToString("yyyy-MM-dd"))" required /></label><label>Produto<select name="produtoId"><option value="">Todos</option>@foreach (Produto p in ViewBag.Produtos) { <option value="@p.Id" selected="@(ViewBag.ProdutoId == p.Id)">@p.Nome</option> }</select></label><label>Categoria<select name="categoriaId"><option value="">Todas</option>@foreach (Categoria c in ViewBag.Categorias) { <option value="@c.Id" selected="@(ViewBag.CategoriaId == c.Id)">@c.Nome</option> }</select></label><label>Modalidade<select name="modalidade"><option value="">Todas</option>@foreach (var m in new[] { "Mesa", "Retirada", "Delivery" }) { <option selected="@(ViewBag.Modalidade == m)">@m</option> }</select></label><label>Pagamento<select name="pagamento"><option value="">Todos</option>@foreach (var p in new[] { "PIX", "Cartão", "Dinheiro" }) { <option selected="@(ViewBag.Pagamento == p)">@p</option> }</select></label><button class="btn primary">Aplicar filtros</button><a class="btn secondary" href="/Relatorios">Limpar</a></form><div class="stats"><article><small>Vendas dos pedidos selecionados</small><strong id="report-total">@Model.Pedidos.Sum(p => p.ValorTotal).ToString("C", br)</strong></article><article><small>Pedidos finalizados</small><strong>@Model.Pedidos.Count</strong></article><article><small>Produtos filtrados (sem taxas)</small><strong>@Model.Itens.Sum(i => i.Valor).ToString("C", br)</strong></article><article><small>Ticket médio dos pedidos</small><strong>@((Model.Pedidos.Count == 0 ? 0 : Model.Pedidos.Average(p => p.ValorTotal)).ToString("C", br))</strong></article></div><p class="muted">Filtros de produto/categoria selecionam pedidos que contêm esses itens. Totais dos pedidos incluem todos os itens e taxas; a tabela de produtos soma apenas os itens filtrados. Categorias refletem o cadastro atual.</p>
<div class="dashboard-grid"><section class="panel table-panel"><div class="table-heading"><h2>Vendas por pagamento</h2><span class="badge">Agrupamento LINQ</span></div><table><thead><tr><th>Pagamento</th><th>Pedidos</th><th>Total</th></tr></thead><tbody>@foreach (GrupoRelatorio g in ViewBag.Pagamentos) { <tr><td>@g.Nome</td><td>@g.Quantidade</td><td>@g.Total.ToString("C", br)</td></tr> }</tbody></table></section><section class="panel table-panel"><div class="table-heading"><h2>Vendas por modalidade</h2></div><table><thead><tr><th>Modalidade</th><th>Pedidos</th><th>Total</th></tr></thead><tbody>@foreach (var g in Model.Pedidos.GroupBy(p => p.TipoAtendimento)) { <tr><td>@g.Key</td><td>@g.Count()</td><td>@g.Sum(p => p.ValorTotal).ToString("C", br)</td></tr> }</tbody></table></section></div>
<section class="panel table-panel"><div class="table-heading"><h2>Vendas por dia e modalidade</h2><span class="badge">Pivot LINQ / MySQL</span></div><div class="table-wrap"><table id="pivot"><thead><tr><th>Período (UTC)</th><th>Mesa</th><th>Retirada</th><th>Delivery</th><th>Total</th></tr></thead><tbody>@foreach (var p in Model.Pivot) { <tr><td>@p.Dia.ToString("dd/MM/yyyy")</td><td>@p.Mesa.ToString("C", br)</td><td>@p.Retirada.ToString("C", br)</td><td>@p.Delivery.ToString("C", br)</td><td>@((p.Mesa + p.Retirada + p.Delivery).ToString("C", br))</td></tr> }</tbody><tfoot><tr><th>Total</th><th>@Model.Pivot.Sum(p => p.Mesa).ToString("C", br)</th><th>@Model.Pivot.Sum(p => p.Retirada).ToString("C", br)</th><th>@Model.Pivot.Sum(p => p.Delivery).ToString("C", br)</th><th>@Model.Pedidos.Sum(p => p.ValorTotal).ToString("C", br)</th></tr></tfoot></table></div></section>
<section class="panel table-panel"><div class="table-heading"><h2>Produtos mais vendidos</h2><span class="badge">Itens + produtos + categorias + pedidos</span></div><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Categoria atual</th><th>Quantidade</th><th>Valor vendido (sem taxas)</th></tr></thead><tbody>@foreach (var g in Model.Itens.GroupBy(i => new { i.Produto, i.Categoria }).OrderByDescending(g => g.Sum(i => i.Quantidade))) { <tr><td>@g.Key.Produto</td><td>@g.Key.Categoria</td><td>@g.Sum(i => i.Quantidade)</td><td>@g.Sum(i => i.Valor).ToString("C", br)</td></tr> }</tbody><tfoot><tr><th colspan="2">Total</th><th>@Model.Itens.Sum(i => i.Quantidade)</th><th>@Model.Itens.Sum(i => i.Valor).ToString("C", br)</th></tr></tfoot></table></div></section>
<section class="panel table-panel"><div class="table-heading"><h2>Pedidos, clientes e operadores</h2></div><div class="table-wrap"><table><thead><tr><th>Pedido</th><th>Cliente na venda</th><th>Operador</th><th>Modalidade</th><th>Total</th></tr></thead><tbody>@foreach (var p in Model.Pedidos) { <tr><td><a href="/Pedidos/Detalhes/@p.Id">#@p.Id</a></td><td>@(p.ClienteHistorico ?? p.Cliente?.Nome ?? "Não identificado")</td><td>@p.Usuario.Nome</td><td>@p.TipoAtendimento</td><td>@p.ValorTotal.ToString("C", br)</td></tr> }</tbody></table></div></section>
@if (Model.Pedidos.Count == 0) { <p class="empty-state">Nenhuma venda finalizada no período e nos filtros selecionados.</p> }

@model Pedido
@{ ViewData["Title"] = "Comanda #" + Model.Id.ToString("D4"); }
<header class="page-header"><div><span class="eyebrow">PEDIDOS / @Model.Status</span><h1>Comanda #@Model.Id.ToString("D4")</h1><p>@Model.DataHora.ToString("dd/MM/yyyy HH:mm") UTC · @Model.TipoAtendimento · Operador @Model.Usuario.Nome</p></div><a class="btn primary" href="/Vendas">Novo pedido</a></header><section class="panel"><dl class="detail-grid"><div><dt>Cliente</dt><dd>@(Model.ClienteHistorico ?? Model.Cliente?.Nome ?? "Não identificado")</dd></div><div><dt>Pagamento</dt><dd>@Model.FormaPagamento</dd></div>@if (Model.NumeroMesa.HasValue) { <div><dt>Mesa</dt><dd>@Model.NumeroMesa</dd></div> }@if (Model.TipoAtendimento == "Delivery") { <div><dt>Endereço da venda</dt><dd>@(Model.EnderecoHistorico ?? Model.Endereco?.Logradouro)</dd></div> }</dl></section><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Quantidade</th><th>Preço da venda</th><th>Subtotal</th></tr></thead><tbody>@foreach (var i in Model.Itens) { <tr><td>@(i.NomeProdutoHistorico ?? i.Produto.Nome)</td><td>@i.Quantidade</td><td>@i.PrecoUnitario.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td><td>@i.SubtotalItem.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td></tr> }</tbody><tfoot><tr><td colspan="3">Subtotal</td><td>@Model.Subtotal.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td></tr><tr><td colspan="3">Taxa de entrega</td><td>@Model.TaxaEntrega.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td></tr><tr><th colspan="3">Total geral</th><th>@Model.ValorTotal.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</th></tr></tfoot></table></div></section><section class="panel"><h2>Acompanhar pedido</h2><div class="row-actions">@if (Model.Status == "ABERTO") { <form asp-action="Status" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="EM PREPARO" /><button class="btn outline">Iniciar preparo</button></form> }@if (Model.Status == "EM PREPARO" && Model.TipoAtendimento == "Delivery") { <form asp-action="Status" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="SAIU PARA ENTREGA" /><button class="btn outline">Saiu para entrega</button></form> }@if (Model.Status != "CANCELADO" && Model.Status != "FINALIZADO") { <form asp-action="Status" method="post" data-confirm="Finalizar pedido e baixar estoque?"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="FINALIZADO" /><button class="btn primary">Finalizar e baixar estoque</button></form> }@if (User.IsInRole("Administrador") && Model.Status != "CANCELADO") { <form asp-action="Status" method="post" data-confirm="Cancelar pedido? Se finalizado, o estoque baixado será estornado."><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="status" value="CANCELADO" /><button class="btn danger">Cancelar pedido</button></form> }<a class="btn secondary" href="/Pedidos">Voltar à lista</a></div><p class="muted">A baixa acontece uma única vez na finalização. Cancelamentos preservam o histórico e geram estorno.</p></section>

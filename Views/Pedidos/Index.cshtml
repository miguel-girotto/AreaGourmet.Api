@model List<Pedido>
@{ ViewData["Title"] = "Pedidos"; }
<header class="page-header"><div><span class="eyebrow">ACOMPANHAMENTO</span><h1>Pedidos e comandas</h1><p>Do primeiro item ao pedido entregue.</p></div><a class="btn primary" href="/Vendas">＋ Novo pedido</a></header><form method="get" class="filters panel"><label>De<input type="date" name="inicio" value="@(((DateTime?)ViewBag.Inicio)?.ToString("yyyy-MM-dd"))" /></label><label>Até<input type="date" name="fim" value="@(((DateTime?)ViewBag.Fim)?.ToString("yyyy-MM-dd"))" /></label><label>Status<select name="status"><option value="">Todos</option>@foreach (var s in new[] { "ABERTO", "EM PREPARO", "SAIU PARA ENTREGA", "FINALIZADO", "CANCELADO" }) { <option selected="@(ViewBag.Status == s)">@s</option> }</select></label><label>Modalidade<select name="modalidade"><option value="">Todas</option>@foreach (var m in new[] { "Mesa", "Retirada", "Delivery" }) { <option selected="@(ViewBag.Modalidade == m)">@m</option> }</select></label><label>Cliente<input name="q" value="@ViewBag.Q" /></label><button class="btn primary">Filtrar</button><a class="btn secondary" href="/Pedidos">Limpar</a></form><section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>Comanda / data (UTC)</th><th>Cliente</th><th>Operador</th><th>Modalidade</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>#@p.Id.ToString("D4")</strong><small>@p.DataHora.ToString("dd/MM/yyyy HH:mm")</small></td><td>@(p.ClienteHistorico ?? p.Cliente?.Nome ?? "Não identificado")</td><td>@p.Usuario.Nome</td><td>@p.TipoAtendimento</td><td><span class="badge @(p.Status == "CANCELADO" ? "neutral" : "")">@p.Status</span></td><td>@p.ValorTotal.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td><td><a href="/Pedidos/Detalhes/@p.Id" class="btn outline small">Ver pedido</a></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="empty-state">Nenhum pedido encontrado.</p> }</section>

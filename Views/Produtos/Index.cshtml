@model List<Produto>
@{ViewData["Title"]="Cardápio";}
<section class="page"><header class="page-header"><div><p class="eyebrow">SABORES DA CASA</p><h1>Cardápio</h1><p class="muted">Produtos, categorias e preços.</p></div>@if(User.IsInRole("Administrador")){<a href="/Produtos/Editar" class="button primary">+ Novo produto</a>}</header><form method="get" class="filters"><input name="busca" value="@ViewBag.Busca" placeholder="Buscar produto" aria-label="Buscar produto"/><select name="categoria" aria-label="Categoria"><option value="">Todas as categorias</option>@foreach(var cat in new[]{"Marmitas","Bebidas","Adicionais"}){<option selected="@(ViewBag.Categoria==cat)">@cat</option>}</select><button>Filtrar</button><a href="/Produtos">Limpar</a></form><div class="table-wrap"><table><thead><tr><th>Produto</th><th>Categoria</th><th>Preço</th><th>Status</th>@if(User.IsInRole("Administrador")){<th>Ações</th>}</tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td>@p.PrecoUnitario.ToString("C")</td><td><span class="badge">@(p.Ativo?"Ativo":"Inativo")</span></td>@if(User.IsInRole("Administrador")){<td><a href="/Produtos/Editar/@p.Id">Editar</a>@if(p.Ativo){<form asp-action="Excluir" asp-route-id="@p.Id" method="post" class="inline confirm"><button class="danger">Inativar</button></form>}</td>}</tr>}</tbody></table></div><p class="muted">@Model.Count registro(s). Exibição limitada a 200.</p></section>

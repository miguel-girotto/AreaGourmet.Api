@model List<Produto>
@{ViewData["Title"]="Estoque";}
<section class="page"><p class="eyebrow">CONTROLE DE UNIDADES</p><h1>Estoque</h1><p class="muted">Baixa automática nas vendas. Produtos com menos de 10 unidades merecem atenção.</p><form method="get" class="filters"><input name="busca" value="@ViewBag.Busca" placeholder="Buscar produto" aria-label="Buscar produto"/><button>Filtrar</button><a href="/Produtos/Estoque">Limpar</a></form><table><thead><tr><th>Produto</th><th>Categoria</th><th>Disponível</th><th>Ação</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nome</td><td>@p.Categoria</td><td><span class="badge @(p.EstoqueInsumo<10?"low":"")">@p.EstoqueInsumo un.</span></td><td><a href="/Produtos/Editar/@p.Id">Ajustar estoque</a></td></tr>}</tbody></table></section>

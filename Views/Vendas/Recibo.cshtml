@model Pedido
@{ViewData["Title"]="Comanda #"+Model.Id.ToString("D4");var tz=TimeZoneInfo.FindSystemTimeZoneById("America/Sao_Paulo");}
<section class="page receipt"><p class="eyebrow">PEDIDO CONCLUÍDO</p><h1>Comanda #@Model.Id.ToString("D4")</h1><p>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(Model.DataHora,DateTimeKind.Utc),tz).ToString("dd/MM/yyyy HH:mm") · @Model.TipoAtendimento @(Model.MesaNumero.HasValue?" · Mesa "+Model.MesaNumero:"")</p><p>Operador: @Model.Usuario.Nome<br/>Cliente: @(Model.Cliente?.Nome??"Balcão")</p>
@if(Model.TipoAtendimento=="Delivery"){<p>Entrega: @Model.EnderecoEntrega</p>}
<table><thead><tr><th>Produto</th><th>Qtd.</th><th>Unitário</th><th>Total</th></tr></thead><tbody>@foreach(var item in Model.Itens){<tr><td>@item.NomeProduto</td><td>@item.Quantidade</td><td>@item.PrecoPraticado.ToString("C")</td><td>@((item.PrecoPraticado*item.Quantidade).ToString("C"))</td></tr>}</tbody></table><p>Entrega: @Model.TaxaEntrega.ToString("C")</p><h2>Total: @Model.ValorTotal.ToString("C")</h2><p>Pagamento: @Model.FormatoPagamento</p><div class="actions no-print"><a class="button primary" href="/Vendas">Novo pedido</a><button type="button" id="print">Imprimir</button></div></section>

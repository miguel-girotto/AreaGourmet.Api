@model PedidoForm
@{ ViewData["Title"] = "Painel de vendas"; var produtos = (List<Produto>)ViewBag.Produtos; }
<div class="pos">
    <section class="sales-catalog">
        <header class="sales-header"><div><span class="eyebrow">ATENDIMENTO</span><h1>Painel de vendas</h1><p>Gerencie e monte pedidos rapidamente.</p></div><div class="segmented" role="group" aria-label="Modalidade"><button type="button" data-mode="Mesa"><svg><use href="/img/icons.svg#grid" /></svg>Mesa</button><button type="button" class="selected" data-mode="Retirada"><svg><use href="/img/icons.svg#bag" /></svg>Retirada</button><button type="button" data-mode="Delivery"><svg><use href="/img/icons.svg#truck" /></svg>Delivery</button></div></header>
        <div class="customer-bar panel"><div class="phone-search"><label for="telefone">BUSCAR CLIENTE</label><div class="search-input"><svg><use href="/img/icons.svg#search" /></svg><input id="telefone" type="search" placeholder="Telefone com DDD" autocomplete="off" /></div><div id="customer-results" class="customer-results" aria-live="polite"></div></div><div class="customer-selected"><small>CLIENTE SELECIONADO</small><div id="customer-name">Venda sem identificação</div><button id="remove-customer" class="text-button" hidden>Remover cliente</button></div><div id="address-field" hidden><label for="endereco">ENDEREÇO DE ENTREGA</label><select id="endereco"><option value="">Selecione o endereço</option></select></div>@if (User.IsInRole("Administrador") || User.HasClaim("clientes", "sim")) { <a href="/Cadastros/Editar?tipo=Clientes" class="btn outline small"><svg><use href="/img/icons.svg#userplus" /></svg>Novo cliente</a> }</div>
        <div class="service-fields"><label id="table-field" hidden>Mesa<input id="mesa" type="number" min="1" max="999" placeholder="Nº da mesa" /></label><label id="fee-field" hidden>Taxa de entrega (R$)<input id="taxa" type="number" min="0" max="9999.99" step="0.01" value="0" /></label></div>
        <div class="catalog-tools"><div class="category-tabs" role="group" aria-label="Categorias"><button class="selected" data-category="all">Todos</button>@foreach (var c in produtos.Select(p => p.Categoria).DistinctBy(c => c.Id)) { <button data-category="@c.Id">@c.Nome</button> }</div><label class="catalog-search"><svg><use href="/img/icons.svg#search" /></svg><input id="product-search" type="search" placeholder="Buscar produto" aria-label="Buscar produto" /></label></div>
        <div class="product-grid" id="products">@foreach (var p in produtos) { var semEstoque = p.EstoqueBebida is not null && p.EstoqueBebida.QuantidadeAtual < 1; <article class="product-card" data-category="@p.CategoriaId" data-name="@p.Nome.ToLowerInvariant()"><div class="product-photo"><img src="@(p.Imagem ?? "/img/placeholder.svg")" alt="@p.Nome" loading="lazy" /><span class="photo-tag">@p.Categoria.Nome</span></div><div class="product-info"><small>@p.Categoria.Nome</small><h2>@p.Nome</h2><p>@(semEstoque ? "Indisponível no momento" : "Preparado com cuidado")</p><div class="product-bottom"><strong>@p.PrecoAtual.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</strong><button class="add-product" data-id="@p.Id" data-name="@p.Nome" data-price="@p.PrecoAtual.ToString(CultureInfo.InvariantCulture)" disabled="@semEstoque"><span aria-hidden="true">＋</span> Adicionar</button></div></div></article> }</div>
        <div id="no-products" class="empty-state" hidden>Nenhum produto encontrado.</div>
        @if (produtos.Count == 0) { <div class="empty-state"><h2>Seu cardápio começa aqui.</h2><p>Peça ao administrador para cadastrar produtos ou gerar os dados de demonstração no painel.</p></div> }
        <footer class="catalog-footer"><span class="status-dot"></span> Atendimento conectado <span>Preços e disponibilidade confirmados ao registrar.</span></footer>
    </section>
    <aside class="cart"><header><div><h2>Nova comanda</h2><p id="cart-mode">Retirada · novo pedido</p></div><button id="clear-cart" class="btn subtle small"><svg><use href="/img/icons.svg#trash" /></svg>Limpar</button></header><div id="cart-items" aria-live="polite"><div class="cart-empty"><svg><use href="/img/icons.svg#bag" /></svg><h3>Vamos montar um pedido?</h3><p>Adicione os produtos do cardápio<br />para começar a comanda.</p></div></div><div class="cart-summary"><div class="summary-line"><span>Subtotal</span><span id="subtotal">R$ 0,00</span></div><div class="summary-line"><span>Taxa de entrega</span><span id="fee-total">R$ 0,00</span></div><div class="total-line"><strong>Total geral</strong><strong id="total">R$ 0,00</strong></div><fieldset class="payments"><legend>MEIO DE PAGAMENTO</legend><label><input type="radio" name="pagamento" value="PIX" checked /><span>Pix</span></label><label><input type="radio" name="pagamento" value="Cartão" /><span>Cartão</span></label><label><input type="radio" name="pagamento" value="Dinheiro" /><span>Dinheiro</span></label></fieldset><div id="sale-error" class="alert error" role="alert" hidden></div><button id="checkout" class="btn primary full"><svg><use href="/img/icons.svg#check" /></svg>Finalizar pedido <span id="checkout-total"></span></button><button id="save-order" class="text-button full">Salvar comanda aberta</button><p class="cart-note">O valor final é calculado pelo servidor.</p></div></aside>
</div>
<form id="sale-token" data-key="@Model.ChaveOperacao">@Html.AntiForgeryToken()</form>
@section Scripts { <script src="~/js/vendas.js" asp-append-version="true" defer></script> }

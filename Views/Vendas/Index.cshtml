@model List<Produto>
@{ViewData["Title"]="Painel de Vendas";}
<div class="pos"><section class="catalog"><header class="pos-header"><div><h1>Painel de Vendas</h1><p class="muted">Gerencie e monte pedidos rapidamente</p></div><div class="segments" id="modes"><button type="button" data-mode="Mesa">▦ Mesa</button><button type="button" data-mode="Retirada" class="selected">▣ Retirada</button><button type="button" data-mode="Delivery">▰ Delivery</button></div></header>
<section class="customer-bar"><div class="lookup"><label class="sr-only" for="phone">Buscar cliente por telefone</label><input id="phone" placeholder="⌕  Telefone do cliente" type="tel" autocomplete="off"/><div id="matches" class="matches"></div></div><div class="selected-customer"><small>CLIENTE SELECIONADO</small><strong id="customer-name">Consumidor no balcão</strong><button type="button" id="clear-customer" class="text-button">Limpar seleção</button></div><div id="address-block" hidden><small>ENDEREÇO DE ENTREGA</small><select id="address" aria-label="Endereço de entrega"></select></div><label id="table-block" hidden>Mesa<input type="number" id="table" min="1" max="999" placeholder="Nº"/></label><a class="button outline" href="/Clientes/Editar">♧ + Novo Cliente</a></section>
<div class="tabs" id="categories"><button class="selected" data-category="Todos">Todos</button><button data-category="Marmitas">Marmitas</button><button data-category="Bebidas">Bebidas</button><button data-category="Adicionais">Adicionais</button></div>
<div class="product-grid">
@foreach(var p in Model){<article class="product" data-category="@p.Categoria"><img src="/images/@p.Imagem" alt="Ilustração de @p.Nome"/><div class="product-info"><small>@p.Categoria</small><h2>@p.Nome</h2><div class="product-bottom"><strong>@p.PrecoUnitario.ToString("C")</strong><button type="button" class="add" data-id="@p.Id" data-name="@p.Nome" data-price="@p.PrecoUnitario.ToString(CultureInfo.InvariantCulture)" data-category="@p.Categoria" data-stock="@(p.ControlaEstoque?p.EstoqueInsumo:999)" disabled="@(p.ControlaEstoque&&p.EstoqueInsumo==0)">@(p.ControlaEstoque&&p.EstoqueInsumo==0?"Esgotado":"+ Adicionar")</button></div></div></article>}
@if(Model.Count==0){<p>Nenhum produto ativo. Peça ao administrador para cadastrar o cardápio.</p>}
</div><footer class="catalog-footer"><span class="status-dot"></span> Seu próximo pedido começa aqui <span>Área Gourmet</span></footer></section>
<aside class="cart"><header><div><h2>Nova comanda</h2><p id="mode-label" class="muted">Canal: Retirada</p></div><button type="button" id="clear" class="button small">♲ Limpar</button></header><div id="cart-items" aria-live="polite"></div><div class="delivery-line" id="delivery-line" hidden><span>⊕ Taxa de entrega</span><strong>R$ 5,00</strong></div><div class="checkout"><div class="totals"><p><span>Subtotal</span><span id="subtotal">R$ 0,00</span></p><p><span>Taxa de entrega</span><span id="fee">R$ 0,00</span></p><p class="grand"><strong>Total Geral</strong><strong id="total">R$ 0,00</strong></p></div><small>MEIO DE PAGAMENTO</small><div class="segments payments" id="payments"><button class="selected" data-payment="Pix">▱ Pix</button><button data-payment="Cartão">▤ Cartão</button><button data-payment="Dinheiro">◎ Dinheiro</button></div><p id="cart-error" role="alert" class="validation"></p><button type="button" id="finish" class="primary">Finalizar Pedido</button></div></aside></div>
<form id="csrf">@Html.AntiForgeryToken()</form>
@section Scripts{<script src="~/js/pos.js" asp-append-version="true"></script>}
